# Local development fallback. Render should set this to the Supabase PostgreSQL
# connection string in the service environment; do not commit credentials here.
DATABASE_URL=sqlite:///./data/app.db

# Host/port used by `python -m app`
HOST=0.0.0.0
PORT=8000

# Browser CORS. Use * (no credentials) for local development, or a
# comma-separated list of frontend origins in production, e.g.
# CORS_ORIGINS=http://localhost:3000,https://your-frontend.example
CORS_ORIGINS=*

# Supabase project URL for JWT verification via the JWKS endpoint (<SUPABASE_URL>/auth/v1/.well-known/jwks.json).
# Set this to your Supabase project URL, e.g. https://<project-ref>.supabase.co
SUPABASE_URL=https://your-project-ref.supabase.co

# Legacy Supabase JWT Secret (optional, no longer required for active ES256 JWKS verification).
SUPABASE_JWT_SECRET=
